<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="iris-readback.ZPM">
    <Module>
      <Name>iris-readback</Name>
      <Version>0.1.0</Version>
      <Description>Critical lab result triage with an AI Hub agent that can raise a severity but never lower a critical, and a human read-back before anyone is notified.</Description>
      <Keywords>interoperability hl7 ai-hub workflow lab critical-results</Keywords>
      <Packaging>module</Packaging>
      <Dependencies>
        <ModuleReference>
          <Name>workflow-rest</Name>
          <Version>*</Version>
        </ModuleReference>
      </Dependencies>
      <SourcesRoot>src</SourcesRoot>
      <!-- The whole Readback package, the agent's tool set (Readback.Tools), the three policies (Readback.Governance), the agent operation
           and its tool host (Readback.Agent) and the release guard (Readback.Triage.ReleaseGuard, Readback.Config.ReleaseGuard). tests/e2e/ipm_check.sh
           proves on a clean instance that each of them is compiled. -->
      <Resource Name="Readback.PKG"/>
      <!-- The product's files go under the instance's manager directory; Readback.Install records that root. -->
      <!-- data/config holds the bounds of the agent's tools and the limits of the release guard. -->
      <FileCopy Name="data/config/" Target="${mgrdir}readback/data/config/"/>
      <FileCopy Name="data/policy/" Target="${mgrdir}readback/data/policy/"/>
      <!-- The measured evaluation and the ablation, read by the read-only MCP server (Readback.MCP). -->
      <FileCopy Name="data/eval/report.json" Target="${mgrdir}readback/data/eval/report.json"/>
      <FileCopy Name="data/eval/ablation.json" Target="${mgrdir}readback/data/eval/ablation.json"/>
      <FileCopy Name="data/replay/" Target="${mgrdir}readback/data/replay/"/>
      <FileCopy Name="data/samples/" Target="${mgrdir}readback/samples/"/>
      <!-- src/python is imported by Readback.Demo.Generator (Embedded Python): the demo generates its messages inside IRIS. -->
      <FileCopy Name="src/python/" Target="${mgrdir}readback/python/"/>
      <FileCopy Name="java/" Target="${mgrdir}readback/java/"/>
      <Invoke Class="Readback.Install" Method="Run" Phase="Activate" When="After"/>
      <Author>
        <Person>Carlos Eduardo Dias Duarte</Person>
        <License>MIT</License>
      </Author>
    </Module>
  </Document>
</Export>
