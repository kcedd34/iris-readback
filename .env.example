OPENAI_API_KEY=
READBACK_DEMO_PASSWORD=
# Interface (optional). The interface is served on READBACK_UI_BIND:READBACK_UI_PORT; the default is loopback only.
# READBACK_PUBLISH_DEMO_ACCOUNTS=1 shows the three demo accounts, with the demo password, on the page (public demo only).
READBACK_UI_BIND=
READBACK_UI_PORT=
READBACK_PUBLISH_DEMO_ACCOUNTS=
