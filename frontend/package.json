{
  "name": "readback-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Live flow panel and read-back task screen for the Readback demo.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check-budget": "node scripts/check-budget.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check-external": "node scripts/check-external.mjs",
    "verify": "npm run build && npm run check-budget && npm run check-contrast && npm run check-external && npm test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
